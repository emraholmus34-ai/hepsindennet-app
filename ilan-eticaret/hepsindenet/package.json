{
  "name": "hepsindenet",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:pwa": "tsc -b && vite build",
    "cap:init": "npx --yes @capacitor/cli init hepsindenet com.hepsindenet.app --web-dir=dist --npm-client=npm",
    "cap:add:android": "npx --yes cap add android",
    "cap:add:ios": "npx --yes cap add ios",
    "cap:sync": "npx --yes cap sync",
    "cap:open:android": "npx --yes cap open android",
    "cap:open:ios": "npx --yes cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^7.4.3",
    "react": "18.x",
    "react-dom": "18.x",
    "react-router-dom": "6.x"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@types/react": "18.x",
    "@types/react-dom": "18.x",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.4.5",
    "vite": "^5.2.0",
    "vite-plugin-pwa": "^0.20.5"
  }
}
